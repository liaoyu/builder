{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "outDir": "lib",
    "rootDir": "src",
    "lib": [
      "es6"
    ],
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "downlevelIteration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "webpackbar/rspack": ["node_modules/webpackbar/dist/rspack.d.cts"]
    },
    "sourceMap": false,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "samples"
  ]
}
